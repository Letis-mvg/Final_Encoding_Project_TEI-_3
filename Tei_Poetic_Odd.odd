<TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:rng="http://relaxng.org/ns/structure/1.0" xmlns:sch="http://purl.oclc.org/dsdl/schematron" xml:lang="en">
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>TEI poetic document</title>
        <author>Léticia Mvondo Mvogo</author>
      </titleStmt>
      <publicationStmt>
        <p>Final assigment class. Rules for presenting poems with TEI</p>
      </publicationStmt>
      <sourceDesc>
        <p>This ODD was initially generated using the TEI Roma tool, following a
          by-example approach based on one encoded sample. The resulting ODD was
          then manually reviewed and customised to introduce project-specific
          constraints on poetic structures. </p>
        <p>Several types of documents, such as RNG and HTML, are derived from this ODD document. 
          Now is the time for us to put into practice the lessons learned in class.From this document, 
          we will have an overview of the schematic structure of each of the poems in our project. 
          The ODD file generated by TEI_Roma was modified manually To insert the missing tag sections</p>
      </sourceDesc>
    </fileDesc>
  </teiHeader>
  <text>
    <body>
      <schemaSpec ident="Tei_Poetic_Odd" start="TEI" docLang="en" prefix="tei_" targetLang="en">
        
        <!-- Modules of the document -->
          <moduleRef key="tagdocs" include="attList attDef sequence content valItem"/>
          <moduleRef key="header"/>
        
        <!-- This part is the header  of our document -->
        
          <moduleRef key="core" include="p title head"/>
        
        <!-- This part is the structure of our document -->
        
          <moduleRef key="tei"/>
          <moduleRef key="textstructure" include="TEI text body div head"/>
        
        <!-- This part is the verse of our document -->
        
          <moduleRef key="verse" include="lg l"/>
          <moduleRef key="namesdates" include="persName forename surname"/>
        
        <!-- This part is the header of the documents -->
        
        <elementSpec ident="titleStmt" mode="change">
          <gloss>Statement of the title and responsible persons</gloss>
          <content>
            <sequence>
              <elementRef key="title" minOccurs="1" maxOccurs="1"/>
              <elementRef key="respStmt" minOccurs="0" maxOccurs="unbounded"/>
            </sequence>
          </content>
        </elementSpec>
        <elementSpec ident="respStmt" mode="change">
          <content>
            <sequence>
              <elementRef key="resp" minOccurs="0" maxOccurs="unbounded"/>
              <elementRef key="persName" minOccurs="0" maxOccurs="unbounded"/>
            </sequence>
          </content>
        </elementSpec>
        <elementSpec ident="persName" mode="change">
          <gloss>Personal name in respStmt</gloss>
          <content>
            <sequence>
              <elementRef key="forename" minOccurs="0" maxOccurs="unbounded"/>
              <elementRef key="surname" minOccurs="0" maxOccurs="unbounded"/>
            </sequence>
          </content>
        </elementSpec>
        <elementSpec ident="publicationStmt" mode="change">
          <gloss>Publication information</gloss>
          <content>
            <sequence>
              <elementRef key="publisher" minOccurs="0" maxOccurs="1"/>
              <elementRef key="availability" minOccurs="0" maxOccurs="1"/>
            </sequence>
          </content>
        </elementSpec>
        
        <elementSpec ident="publisher" mode="change">
          <gloss>Publisher name</gloss>
        </elementSpec>
        
        <elementSpec ident="availability" mode="change">
          <gloss>Availability of the document</gloss>
          <content>
            <elementRef key="p" minOccurs="1" maxOccurs="unbounded"/>
          </content>
        </elementSpec>
              
        <elementSpec ident="sourceDesc" mode="change">
          <gloss>Information about the source of the encoded text</gloss>
          <content>
              <elementRef key="bibl" minOccurs="0" maxOccurs="unbounded"/>
          </content>
        </elementSpec>
        
        <elementSpec ident="bibl" mode="change">
          <gloss>Bibliographic information</gloss>
          <content>
            <sequence>
              <elementRef key="title" minOccurs="1" maxOccurs="1"/>
              <elementRef key="author" minOccurs="0" maxOccurs="1"/>
              <elementRef key="editor" minOccurs="0" maxOccurs="1"/>
              <elementRef key="publisher" minOccurs="0" maxOccurs="1"/>
              <elementRef key="pubPlace" minOccurs="0" maxOccurs="1"/>
              <elementRef key="date" minOccurs="0" maxOccurs="1"/>
              <elementRef key="idno" minOccurs="1" maxOccurs="1"/>
            </sequence>
          </content>
        </elementSpec>
        
        
        <!-- The structure for poems -->
        
        <elementSpec ident="body" mode="change">
          <gloss>Main text of the document</gloss>
          <content>
            <elementRef key="div" minOccurs="1" maxOccurs="1"/>
          </content>
        </elementSpec>
        
            
        
        <!-- The use of div for poems -->
           
          <elementSpec ident="div" mode="replace">
            <desc>[Change] Restricting div to act specifically as a container for these poems. Each poem have our proper title and number</desc>
            <gloss>Division corresponding to a poem</gloss>
            <content>
              <sequence>
                <elementRef key="head" minOccurs="1" maxOccurs="1"/>
                <elementRef key="lg" minOccurs="1" maxOccurs="unbounded"/>
              </sequence>
            </content>
            <attList>
              <!-- Other type of attribute -->
              
              <attDef ident="type" usage="req">
                <desc>Must indicate the type of content</desc>
                <valList type="closed">
                  <valItem ident="poem"/>
                </valList>
              </attDef>
              
              <attDef ident="n" usage="opt">
                <desc>Editorial numbering of the poem in Roman numerals</desc>
                <valList type="closed">
                  <valItem ident="CVII"/>
                  <valItem ident="III"/>
                  <valItem ident="XIII"/>
                </valList>
              </attDef>
            </attList>  
          </elementSpec>
       
          <elementSpec ident="head" mode="change">
            <gloss>Title of the poem</gloss>
          </elementSpec>
          
          <!-- The use of lg for stanzas-->
        
          <elementSpec ident="lg" mode="change">
            <gloss>Poetic stanza</gloss>
            
            <attList>
              <attDef ident="type" usage="req">
                <desc>Type of stanza : quatrain, sestain, etc.</desc>
                <valList type="closed">
                  <valItem ident="quatrain"/>
                  <valItem ident="sestain"/>
                </valList>
              </attDef>
            </attList>

            
            <!-- Exemplum : Each poem has a similar structure-->
            <exemplum>
              <egXML xmlns="http://www.tei-c.org/ns/Examples">
                
                <!-- In the poems of Beaudelaire and Paul Verlaine, the structure of stanza is as follows-->
                
                   <!-- Part of the poem number one-->
                
                <lg>
                  <l n="1" rhyme="A">A for first verse</l>
                  <l n="2" rhyme="B">B for second verse</l>
                  <l n="3" rhyme="B">B for third verse</l>
                  <l n="4" rhyme="A">A for the fourth verse</l>
                </lg>
                <lg>
                  <l n="1" rhyme="C">C for first verse</l>
                  <l n="2" rhyme="D">D for second verse</l>
                  <l n="3" rhyme="D">D for third verse</l>
                  <l n="4" rhyme="C">C for the fourth verse</l>
                </lg>
                
                <!-- Part of the poem number three-->
                
                <lg>
                  <l n="1" rhyme="A">A for first verse</l>
                  <l n="2" rhyme="A">A for second verse</l>
                  <l n="3" rhyme="B">B for the third verse</l>
                  <l n="4" rhyme="C">C for the fourth verse</l>
                  <l n="5" rhyme="C">C for the fifth verse</l>
                  <l n="6" rhyme="B">B for the sixth verse</l>
                </lg>
                <lg>
                  <l n="1" rhyme="D">D for first verse</l>
                  <l n="2" rhyme="D">D for second verse</l>
                  <l n="3" rhyme="E">E for the third verse</l>
                  <l n="4" rhyme="F">F for the fourth verse</l>
                  <l n="5" rhyme="F">F for the fifth verse</l>
                  <l n="6" rhyme="E">E for the sixth verse</l>
                </lg>
              </egXML>
            </exemplum>
          </elementSpec>
        
        <constraintSpec xmlns:tei="http://www.tei-c.org/ns/1.0"
          xmlns:sch="http://purl.oclc.org/dsdl/schematron"
          ident="lg"
          scheme="schematron">
          
          <constraint>
            <sch:rule context="tei:lg[@type='quatrain']">
              <sch:report test="count(tei:l) != 4" role="error">
                [Note change] This part must have exactly 4 lines
              </sch:report>
            </sch:rule>
            
            <sch:rule context="tei:lg[@type='sestain']">
              <sch:report test="count(tei:l) != 6" role="error">
                This part must have 6 lines
              </sch:report>
            </sch:rule>
          </constraint>
          
        </constraintSpec>
        
        
        <!-- The use of l for verses -->
        
        <elementSpec ident="l" mode="change">
          <gloss>Poetic line</gloss>
          <attList>  
            <!-- N is the attribute of the number of l in the stanza -->
            <attDef ident="n" usage="opt">
              <desc>Number of the line in the stanza</desc>
              <valList type="closed">
                <valItem ident="1"/>
                <valItem ident="2"/>
                <valItem ident="3"/>
                <valItem ident="4"/>
                <valItem ident="5"/>
                <valItem ident="6"/>
              </valList>
            </attDef>
            
            <!-- Attribute to indicate a rhyme -->
            
            <attDef ident="rhyme" usage="opt">
              <desc>Rhyme label of the line, we have : A, B, C, D, E and F</desc>
              <valList type="closed">
                <valItem ident="A"/>
                <valItem ident="B"/>
                <valItem ident="C"/>
                <valItem ident="D"/>
                <valItem ident="E"/>
                <valItem ident="F"/>
              </valList>
            </attDef>
          </attList>
        </elementSpec>
        
        <elementSpec ident="persName" mode="change">
          <gloss>Personal name</gloss>
          <content>
            <sequence>
              <elementRef key="forename" minOccurs="0" maxOccurs="unbounded"/>
              <elementRef key="surname" minOccurs="0" maxOccurs="unbounded"/>
            </sequence>
          </content>
        </elementSpec>
        <elementSpec ident="forename" mode="change">
          <gloss>Forename</gloss>
        </elementSpec>
        <elementSpec ident="surname" mode="change">
          <gloss>Surname</gloss>
        </elementSpec>
     </schemaSpec>
    </body>
  </text>
</TEI>